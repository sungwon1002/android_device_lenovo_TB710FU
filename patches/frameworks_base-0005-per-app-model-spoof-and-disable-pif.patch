+    /**
+     * User-configurable per-app Build.MODEL spoofing. Settings.Secure
+     * "per_app_model_spoof" holds a ';'-separated list of "package=model"
+     * entries; an app in the list reports the given model. Parsed once per
+     * process; apps are restarted to pick up changes.
+     */
+    private static void applyPerAppModelSpoof(Context context, String packageName) {
+        try {
+            if (sPerAppModel == null) {
+                final Map<String, String> map = new HashMap<>();
+                final String raw = Settings.Secure.getString(
+                        context.getContentResolver(), PER_APP_MODEL_KEY);
+                if (raw != null && !raw.isEmpty()) {
+                    for (String entry : raw.split(";")) {
+                        final int eq = entry.indexOf('=');
+                        if (eq > 0 && eq < entry.length() - 1) {
+                            map.put(entry.substring(0, eq).trim(),
+                                    entry.substring(eq + 1).trim());
+                        }
+                    }
+                }
+                sPerAppModel = map;
+            }
+            final String model = sPerAppModel.get(packageName);
+            if (model != null && !model.isEmpty()) {
+                setPropValue("MODEL", model);
+                if (DEBUG) Log.d(TAG, "per-app MODEL spoof: " + packageName + " -> " + model);
+            }
+        } catch (Throwable t) {
+            // Never break app startup over spoofing.
+        }
+    }
