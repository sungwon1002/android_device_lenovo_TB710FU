+    // The 240x320dp preview surface assumes the 4:3 landscape camera frames
+    // are rotated to portrait. When the display rotation cancels the sensor
+    // orientation (e.g. a landscape tablet whose front camera is mounted at
+    // 270) the preview stays landscape, so swap the surface size instead of
+    // stretching the face.
+    private fun fitSurfaceToPreview() {
+        val cameraId = CameraUtil.getCameraId(this)
+        if (cameraId < 0) return
+        val info = Camera.CameraInfo()
+        Camera.getCameraInfo(cameraId, info)
+        val degrees = (display?.rotation ?: 0) * 90
+        if ((info.orientation + degrees) % 180 != 0) return
+        val lp = mSurfaceView?.layoutParams ?: return
+        val width = lp.width
+        lp.width = lp.height
+        lp.height = width
+        mSurfaceView?.layoutParams = lp
+    }
+
