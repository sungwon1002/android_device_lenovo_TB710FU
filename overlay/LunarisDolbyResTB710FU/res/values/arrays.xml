<resources>
    <!-- Profiles the stock DAX tuning (vendor/etc/dolby/dax-default.xml) defines:
         0 Dynamic, 1 Movie, 2 Music, 3 Voice, 8 Game. The upstream LunarisDolby
         list (0..6: dynamic/video/music/game/work/casual/mood) does not match this
         tuning, so restrict the UI to the five profiles the DAX actually ships. -->
    <string-array name="dolby_profile_entries" translatable="false">
        <item>Dynamic</item>
        <item>Movie/Video</item>
        <item>Music</item>
        <item>Voice</item>
        <item>Game</item>
    </string-array>

    <string-array name="dolby_profile_values" translatable="false">
        <item>0</item>
        <item>1</item>
        <item>2</item>
        <item>3</item>
        <item>8</item>
    </string-array>
</resources>
