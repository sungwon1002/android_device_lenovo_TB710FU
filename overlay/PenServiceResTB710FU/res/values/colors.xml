<!-- The pen pages come from the stock Lenovo PenService (ZUI 17.5). Its
     zui.appcompat theme paints them with the static #ff666666/#ff191919 greys
     and its own accent; map the preference text and the switch onto the
     dynamic system palette so the pages match the rest of Settings. Only plain
     colour resources are overlaid (the selectors on top of them keep their
     disabled states); values-night follows with the dark roles. -->
<resources>
    <!-- Preference title -->
    <color name="list_item_text_normal_zui">@android:color/system_neutral1_900</color>
    <color name="list_item_text_disabled_zui">@android:color/system_neutral2_300</color>
    <!-- Preference summary -->
    <color name="list_item_second_line_text_normal_zui">@android:color/system_neutral2_600</color>
    <!-- Category title: PixelOS Settings titles use the primary colour above
         the card groups (BasePreferenceFragmentCompat in lenovo/PenService),
         on the page background. -->
    <color name="preference_category_text_zui">@android:color/system_accent1_600</color>
    <color name="preference_category_bg_zui">@android:color/transparent</color>
    <!-- Switch (track when on) and its pressed/hovered states -->
    <color name="system_primary_color_on_zui">@android:color/system_accent1_600</color>
    <color name="system_primary_color_on_pressed_zui">@android:color/system_accent1_700</color>
    <color name="system_primary_color_on_hovered_zui">@android:color/system_accent1_700</color>
    <color name="system_primary_color_off_pressed_zui">@android:color/system_neutral2_600</color>
    <color name="system_icon_off_color_zui">@android:color/system_neutral2_300</color>
    <!-- Page and navigation bar background: the PixelOS Settings background
         (settingslib_materialColorSurfaceContainer). -->
    <color name="background_zui">@android:color/system_surface_container_light</color>
</resources>
