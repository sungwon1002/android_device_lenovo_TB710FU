    <!-- From the stock vendor FrameworksResTarget_Vendor overlay -->
    <bool name="config_powerDecoupleAutoSuspendModeFromDisplay">true</bool>
    <!-- Without this WindowManager reports no navigation bar, so SystemUI
         never creates the taskbar and the back gesture handler. -->
    <bool name="config_showNavigationBar">true</bool>
    <bool name="config_useDevInputEventForAudioJack">true</bool>

    <!-- Color modes (Settings > Display > Colors): Natural, Boosted, Adaptive.
         Adaptive (persist.sys.sf.native_mode=2, system_ext.prop) is the default.
         Without any color mode ColorDisplayService never activates white balance
         (DisplayTransformManager.needsLinearColorMatrix() is false). -->
    <integer-array name="config_availableColorModes">
        <item>0</item>
        <item>1</item>
        <item>3</item>
    </integer-array>

    <!-- Adaptive white balance ("True Tone"): the tcs3408 RGB sensor reports the
         ambient color temperature in Kelvin as values[0] of qti.sensor.rgb.
         Switch and strength slider: Lenovo features (TB710FUParts); the Settings
         switch is hidden (SettingsResTB710FU).
         The mapping follows the stock ZUI one (AutoColorTempUtil.convertAmbient2Screen):
         ambient <3000K -> 5800K, 3000-4000 -> 6100, 4000-5000 -> 6500 (neutral),
         5000-6000 -> 7100, 6000-7000 -> 7800, 7000-8000 -> 8500, >8000 -> 9500;
         below 50 lux neutral, above 1000 lux 7500K. Without a mapping AOSP shows the
         ambient CCT itself, which made indoor light very yellow. -->
    <bool name="config_displayWhiteBalanceAvailable">true</bool>
    <!-- Off by default (user request): display white balance auto value disabled -->
    <bool name="config_displayWhiteBalanceEnabledDefault">false</bool>
    <string name="config_displayWhiteBalanceColorTemperatureSensorName" translatable="false">qti.sensor.rgb</string>
    <integer name="config_displayWhiteBalanceColorTemperatureMin">5800</integer>
    <integer name="config_displayWhiteBalanceColorTemperatureMax">9500</integer>
    <array name="config_displayWhiteBalanceAmbientColorTemperatures">
        <item>2800.0</item>
        <item>3500.0</item>
        <item>4500.0</item>
        <item>5500.0</item>
        <item>6500.0</item>
        <item>7500.0</item>
        <item>8500.0</item>
    </array>
    <array name="config_displayWhiteBalanceDisplayColorTemperatures">
