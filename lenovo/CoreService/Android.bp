//
// Lenovo ZUI core service (ZuiCoreService, com.zui.cores) from the stock CN
// ROM. It is the system API bridge that ZuiGameHelper talks to for the actual
// game-booster actions (it defines com.zui.cores.permission.INVOKE_SYSTEM_API /
// USE_CORE_APIS). Runs as android.uid.system, so it must be signed with the
// platform key.

android_app_import {
    name: "ZuiCoreService",
    owner: "lenovo",
    apk: "ZuiCoreService.apk",
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
    system_ext_specific: true,
    required: [
        "privapp-permissions-com.zui.cores.xml",
    ],
}

prebuilt_etc {
    name: "privapp-permissions-com.zui.cores.xml",
    src: "privapp-permissions-com.zui.cores.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
