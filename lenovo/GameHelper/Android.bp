//
// Lenovo game assistant (ZuiGameHelper, com.zui.game.service) from the stock
// CN ROM, with its game-booster backend libs.

android_app_import {
    name: "ZuiGameHelper",
    owner: "lenovo",
    apk: "ZuiGameHelper.apk",
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
    system_ext_specific: true,
    required: [
        "privapp-permissions-com.zui.game.service.xml",
    ],
}

prebuilt_etc {
    name: "privapp-permissions-com.zui.game.service.xml",
    src: "privapp-permissions-com.zui.game.service.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
