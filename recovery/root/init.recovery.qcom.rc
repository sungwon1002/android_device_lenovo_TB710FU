#
# TB710FU recovery init, trimmed from the stock init.recovery.qcom.rc
# (same USB / bootdevice / ADSP handling as the -twrp tree).

on early-init
    # ADSP loader chain (vendor_dlkm modules, shipped in the recovery ramdisk
    # like on stock). The battery and charger live behind the ADSP; without it
    # the recovery UI waits 5 s for a battery that never shows up.
    insmod /vendor/modules/q6_pdr_dlkm.ko
    insmod /vendor/modules/q6_notifier_dlkm.ko
    insmod /vendor/modules/snd_event_dlkm.ko
    insmod /vendor/modules/gpr_dlkm.ko
    insmod /vendor/modules/spf_core_dlkm.ko
    insmod /vendor/modules/adsp_loader_dlkm.ko

on init
    # bootable/recovery/etc/init.rc sets up the configfs gadget on fs
    setprop sys.usb.configfs 1

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    wait /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode
    write /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode peripheral
    wait /sys/class/udc/${ro.boot.usbcontroller} 1

on fs
    # recovery.fstab uses /dev/block/bootdevice/by-name/*
    wait /dev/block/platform/soc/1d84000.ufshc
    symlink /dev/block/platform/soc/1d84000.ufshc /dev/block/bootdevice

    # Boot the ADSP from the modem partition firmware
    mkdir /vendor/firmware_mnt 0755 root root
    mount_all /vendor/etc/charger_fw_fstab.qti --early
    wait /sys/kernel/boot_adsp/boot
    write /sys/kernel/boot_adsp/boot 1
    wait /sys/class/power_supply/battery
