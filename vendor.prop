# Display (Lenovo addition on top of init.qti.display_boot.sh)
vendor.display.disable_get_screen_decorator_support=1

# Boot animation: the natural orientation is portrait (touch/pen/sensors), the
# tablet is used in landscape
ro.bootanim.set_orientation_logical_0=ORIENTATION_90

# Blur (notification shade, recents, dialogs); SM8650 handles it fine
ro.surface_flinger.supports_background_blur=1

# Camera: the camx HAL applies the Lenovo 3A/ISP tuning only while
# vendor.camera.packagename.zui is set. The ZUI cameraserver sets it for its
# own camera app; PixelOS never does, so every app got the dark untuned path.
vendor.camera.packagename.zui=com.zui.camera

# Lenovo device/pen identity from the stock vendor build.prop (ZUI_17.5.10.362).
# PenService picks the settings screen (Pen Pro: battery, writing vibration,
# brush effects) from pen.compat.project + pen_info; without them every pen
# showed the generic capacitive pen page. ZuiUDevice uses the keyboard names.
# ro.config.lgsi.* (system) is left out on purpose: apps treat it as ZUI
# (except ro.config.lgsi.device.type, see system_ext.prop).
ro.vendor.config.lgsi.pen.bluetooth_key.support=1
ro.vendor.config.lgsi.pen.compat.project=1
ro.vendor.config.lgsi.pen.event.name=touch-pen
ro.vendor.config.lgsi.pen_info=0x617F:0x17EF:Lenovo Tab Pen Plus;0x61A1:0x17EF:Lenovo Tab Pen Pro
ro.vendor.config.lgsi.olympia_kb.name=Lenovo Wireless KB
ro.vendor.config.lgsi.olympia_kb.name.row=Lenovo Multi-Device Wireless Keyboard
ro.vendor.config.lgsi.device.type=pad
ro.vendor.config.lgsi.hw.version=TB710FU
ro.vendor.config.lgsi.market_name=Lenovo Xiaoxin Pad Pro GT
ro.vendor.config.lgsi.short_market_name=Lenovo Xiaoxin Pad Pro GT
ro.vendor.config.lgsi.project=topaz
ro.vendor.config.lgsi.platform=qcom
ro.vendor.config.lgsi.not_support_vibrator=true
